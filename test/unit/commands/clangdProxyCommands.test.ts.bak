/**
 * clangdProxyCommands.test.ts —— Clangd Proxy 命令单元测试
 *
 * 测试策略：
 * - 使用 vi.mocked 模拟 vscode 和 ClangdProxyManager
 * - 验证 Enable 写入设置并显示成功消息
 * - 验证 Disable 恢复设置，无备份时显示警告不抛出
 * - 验证 Show Status 显示所有状态字段
 * - 验证 package.json manifest 包含三个命令
 */

import { describe, it, expect, beforeEach, vi } from 'vitest';
import * as vscode from 'vscode';
import { executeEnableClangdProxy } from '@commands/enableClangdProxy';
import { executeDisableClangdProxy } from '@commands/disableClangdProxy';
import { executeShowClangdProxyStatus } from '@commands/showClangdProxyStatus';
import { Config } from '@core/config';

// ---------------------------------------------------------------------------
// 辅助：创建 Logger mock
// ---------------------------------------------------------------------------

function createLoggerMock() {
  return {
    info: vi.fn(),
    warn: vi.fn(),
    error: vi.fn(),
    debug: vi.fn(),
    show: vi.fn(),
  };
}

// ---------------------------------------------------------------------------
// 辅助：创建 Config mock
// ---------------------------------------------------------------------------

function createConfigMock(overrides?: Partial<{
  clangdProxyEnabled: boolean;
  clangdProxyKeepaliveMax: number;
  clangdProxyKeepaliveTtlSec: number;
  clangdProxyRealClangdPath: string | undefined;
  clangdProxyLogPath: string | undefined;
}>) {
  return {
    clangdProxyEnabled: false,
    clangdProxyKeepaliveMax: 20,
    clangdProxyKeepaliveTtlSec: 900,
    clangdProxyRealClangdPath: undefined,
    clangdProxyLogPath: undefined,
    update: vi.fn(),
    onDidChange: vi.fn(() => ({ dispose: vi.fn() })),
    ...overrides,
  } as unknown as Config;
}

// ---------------------------------------------------------------------------
// 辅助：创建 ClangdHandles mock
// ---------------------------------------------------------------------------

function createClangdHandlesMock(overrides?: {
  enabled?: boolean;
  isActive?: boolean;
  hasBackup?: boolean;
  launcherPath?: string;
  logPath?: string | undefined;
  enableResult?: { restored: boolean; warning?: string };
  disableResult?: { restored: boolean; warning?: string };
}) {
  const o = overrides ?? {};
  return {
    completionMode: {} as never,
    backup: {} as never,
    proxyManager: {
      enabled: o.enabled ?? false,
      isActive: o.isActive ?? false,
      hasBackup: o.hasBackup ?? false,
      launcherPath: o.launcherPath ?? '/fake/extension/out/launcher/proxy-launcher.bat',
      logPath: o.logPath ?? undefined,
      enable: vi.fn(async () => {}),
      disable: vi.fn(async () => o.disableResult ?? { restored: true }),
    },
  };
}

// ===========================================================================
// 测试套件
// ===========================================================================

describe('executeEnableClangdProxy — 启用代理命令', () => {
  let config: Config;
  let logger: ReturnType<typeof createLoggerMock>;

  beforeEach(() => {
    config = createConfigMock();
    logger = createLoggerMock();
    vi.clearAllMocks();
  });

  it('已激活时跳过并显示信息', async () => {
    const clangd = createClangdHandlesMock({ isActive: true });

    await executeEnableClangdProxy(config, logger, clangd as never);

    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('already active'),
    );
    expect(vscode.window.showInformationMessage).toHaveBeenCalledWith(
      expect.stringContaining('already'),
    );
    // 不应调用 enable
    expect(clangd.proxyManager.enable).not.toHaveBeenCalled();
  });

  it('启用成功时写入设置并显示成功消息', async () => {
    const clangd = createClangdHandlesMock({ enabled: true });

    await executeEnableClangdProxy(config, logger, clangd as never);

    expect(clangd.proxyManager.enable).toHaveBeenCalledOnce();
    expect(config.update).toHaveBeenCalledWith('clangdProxy.enabled', true);
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('proxy enabled successfully'),
    );
  });

  it('启用失败时显示错误消息', async () => {
    const clangd = createClangdHandlesMock({ enabled: true });
    clangd.proxyManager.enable = vi.fn(async () => {
      throw new Error('mock failure');
    });

    await executeEnableClangdProxy(config, logger, clangd as never);

    expect(logger.error).toHaveBeenCalledWith(
      expect.stringContaining('failed'),
      expect.any(Error),
    );
    expect(vscode.window.showErrorMessage).toHaveBeenCalled();
  });
});

describe('executeDisableClangdProxy — 禁用代理命令', () => {
  let config: Config;
  let logger: ReturnType<typeof createLoggerMock>;

  beforeEach(() => {
    config = createConfigMock();
    logger = createLoggerMock();
    vi.clearAllMocks();
  });

  it('禁用成功时恢复设置并显示成功消息', async () => {
    const clangd = createClangdHandlesMock({
      disableResult: { restored: true },
    });

    await executeDisableClangdProxy(config, logger, clangd as never);

    expect(clangd.proxyManager.disable).toHaveBeenCalledOnce();
    expect(config.update).toHaveBeenCalledWith('clangdProxy.enabled', false);
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('settings restored'),
    );
  });

  it('无备份时显示警告但不抛出异常', async () => {
    const clangd = createClangdHandlesMock({
      disableResult: { restored: false, warning: '未找到备份' },
    });

    // 确保不会抛出
    await expect(
      executeDisableClangdProxy(config, logger, clangd as never),
    ).resolves.toBeUndefined();

    expect(logger.warn).toHaveBeenCalledWith(
      expect.stringContaining('未找到备份'),
    );
    expect(vscode.window.showWarningMessage).toHaveBeenCalled();
  });

  it('禁用失败时显示错误消息', async () => {
    const clangd = createClangdHandlesMock();
    clangd.proxyManager.disable = vi.fn(async () => {
      throw new Error('mock failure');
    });

    await executeDisableClangdProxy(config, logger, clangd as never);

    expect(logger.error).toHaveBeenCalledWith(
      expect.stringContaining('failed'),
      expect.any(Error),
    );
    expect(vscode.window.showErrorMessage).toHaveBeenCalled();
  });
});

describe('executeShowClangdProxyStatus — 显示状态命令', () => {
  let config: Config;
  let logger: ReturnType<typeof createLoggerMock>;

  beforeEach(() => {
    config = createConfigMock({
      clangdProxyEnabled: true,
      clangdProxyRealClangdPath: '/usr/bin/clangd',
      clangdProxyLogPath: '/tmp/clangd-proxy.log',
    });
    logger = createLoggerMock();
    vi.clearAllMocks();
  });

  it('显示所有状态字段到 output 和信息消息', async () => {
    const clangd = createClangdHandlesMock({
      enabled: true,
      isActive: true,
      hasBackup: true,
      launcherPath: '/fake/extension/out/launcher/proxy-launcher.bat',
      logPath: '/tmp/clangd-proxy.log',
    });

    await executeShowClangdProxyStatus(config, logger, clangd as never);

    // 验证 logger.show 被调用
    expect(logger.show).toHaveBeenCalledOnce();

    // 验证 logger.info 包含状态信息
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('Config Enabled'),
    );
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('Currently Active'),
    );
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('Launcher Path'),
    );
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('Real Clangd'),
    );
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('Keepalive Max'),
    );
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('Keepalive TTL'),
    );
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('Log Path'),
    );
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('Backup Exists'),
    );

    // 验证 showInformationMessage 被调用
    expect(vscode.window.showInformationMessage).toHaveBeenCalled();
  });

  it('未配置路径时显示自动检测', async () => {
    const configNoPath = createConfigMock({
      clangdProxyRealClangdPath: undefined,
      clangdProxyLogPath: undefined,
    });
    const clangd = createClangdHandlesMock({
      enabled: false,
      isActive: false,
      hasBackup: false,
      logPath: undefined,
    });

    await executeShowClangdProxyStatus(configNoPath, logger, clangd as never);

    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('auto-detect'),
    );
    expect(logger.info).toHaveBeenCalledWith(
      expect.stringContaining('not set'),
    );
  });
});

describe('package.json manifest — 命令清单验证', () => {
  it('package.json 包含 enableClangdProxy 命令', async () => {
    const pkg = await import('../../../package.json');
    const commands = (pkg as { contributes: { commands: Array<{ command: string }> } }).contributes.commands;
    const cmdIds = commands.map((c) => c.command);
    expect(cmdIds).toContain('vscodeUEHelper.enableClangdProxy');
    expect(cmdIds).toContain('vscodeUEHelper.disableClangdProxy');
    expect(cmdIds).toContain('vscodeUEHelper.showClangdProxyStatus');
  });

  it('package.json commandPalette 包含三个 proxy 命令', async () => {
    const pkg = await import('../../../package.json');
    const palette = (pkg as { contributes: { menus: { commandPalette: Array<{ command: string }> } } }).contributes.menus.commandPalette;
    const paletteCmds = palette.map((c) => c.command);
    expect(paletteCmds).toContain('vscodeUEHelper.enableClangdProxy');
    expect(paletteCmds).toContain('vscodeUEHelper.disableClangdProxy');
    expect(paletteCmds).toContain('vscodeUEHelper.showClangdProxyStatus');
  });
});
