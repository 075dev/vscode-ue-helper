{
  "name": "vscode-ue-helper",
  "displayName": "VSCode UE Helper",
  "description": "All-in-one VS Code plugin for Unreal Engine C++ development: UBT build, Live Coding hot-reload, clangd IntelliSense, and optional MCP AI agent integration.",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/075dev/vscode-ue-helper.git"
  },
  "publisher": "vscode-ue-helper",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "platforms": [
    "win32"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "unreal-engine",
    "ue5",
    "clangd",
    "cpp",
    "live-coding",
    "mcp",
    "model-context-protocol"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:**/*.uproject",
    "onCommand:vscodeUEHelper.build",
    "onCommand:vscodeUEHelper.rebuild",
    "onCommand:vscodeUEHelper.clean",
    "onCommand:vscodeUEHelper.launchEditor",
    "onCommand:vscodeUEHelper.liveCoding",
    "onCommand:vscodeUEHelper.generateCompileCommands",
    "onCommand:vscodeUEHelper.createProject",
    "onCommand:vscodeUEHelper.diagnoseProject",
    "onCommand:vscodeUEHelper.showProjectInfo",
    "onCommand:vscodeUEHelper.setSystemIncludes",
    "onCommand:vscodeUEHelper.installRules",
    "onCommand:vscodeUEHelper.uninstall",
    "onCommand:vscodeUEHelper.openWorkspaceFile",
    "onCommand:vscodeUEHelper.openTerminalInNewWindow",
    "onCommand:vscodeUEHelper.selectConfig",
    "onCommand:vscodeUEHelper.selectTarget",
    "onCommand:vscodeUEHelper.enableClangdProxy",
    "onCommand:vscodeUEHelper.disableClangdProxy",
    "onCommand:vscodeUEHelper.showClangdProxyStatus",
    "onCommand:vscodeUEHelper.showControlPanel",
    "onCommand:vscodeUEHelper.retryFirstTimeInit",
    "onCommand:vscodeUEHelper.refreshProjectExplorer",
    "onCommand:vscodeUEHelper.openProjectExplorerFile",
    "onCommand:vscodeUEHelper.copyBuildCommand",
    "onCommand:vscodeUEHelper.noLintCurrentLine",
    "onCommand:vscodeUEHelper.noLintNextLine",
    "onCommand:vscodeUEHelper.switchHeaderSource"
  ],
  "main": "out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscodeUEHelper.build",
        "title": "%cmd.build.title%",
        "category": "UE Helper",
        "icon": "$(tools)"
      },
      {
        "command": "vscodeUEHelper.rebuild",
        "title": "%cmd.rebuild.title%",
        "category": "UE Helper",
        "icon": "$(refresh)"
      },
      {
        "command": "vscodeUEHelper.clean",
        "title": "%cmd.clean.title%",
        "category": "UE Helper",
        "icon": "$(trash)"
      },
      {
        "command": "vscodeUEHelper.launchEditor",
        "title": "%cmd.launchEditor.title%",
        "category": "UE Helper",
        "icon": "$(play)"
      },
      {
        "command": "vscodeUEHelper.liveCoding",
        "title": "%cmd.liveCoding.title%",
        "category": "UE Helper",
        "icon": "$(zap)"
      },
      {
        "command": "vscodeUEHelper.generateCompileCommands",
        "title": "%cmd.generateCompileCommands.title%",
        "category": "UE Helper"
      },
      {
        "command": "vscodeUEHelper.diagnoseProject",
        "title": "%cmd.diagnoseProject.title%",
        "category": "UE Helper",
        "icon": "$(checklist)"
      },
      {
        "command": "vscodeUEHelper.createProject",
        "title": "%cmd.createProject.title%",
        "category": "UE Helper",
        "icon": "$(new-folder)"
      },
      {
        "command": "vscodeUEHelper.showProjectInfo",
        "title": "%cmd.showProjectInfo.title%",
        "category": "UE Helper",
        "icon": "$(info)"
      },
      {
        "command": "vscodeUEHelper.setSystemIncludes",
        "title": "%cmd.setSystemIncludes.title%",
        "category": "UE Helper"
      },
      {
        "command": "vscodeUEHelper.installRules",
        "title": "%cmd.installRules.title%",
        "category": "UE Helper"
      },
      {
        "command": "vscodeUEHelper.uninstall",
        "title": "%cmd.uninstall.title%",
        "category": "UE Helper",
        "icon": "$(trash)"
      },
      {
        "command": "vscodeUEHelper.openWorkspaceFile",
        "title": "%cmd.openWorkspaceFile.title%",
        "category": "UE Helper"
      },
      {
        "command": "vscodeUEHelper.openTerminalInNewWindow",
        "title": "%cmd.openTerminalInNewWindow.title%",
        "category": "UE Helper",
        "icon": "$(terminal)"
      },
      {
        "command": "vscodeUEHelper.selectConfig",
        "title": "%cmd.selectConfig.title%",
        "category": "UE Helper",
        "icon": "$(gear)"
      },
      {
        "command": "vscodeUEHelper.selectTarget",
        "title": "%cmd.selectTarget.title%",
        "category": "UE Helper",
        "icon": "$(symbol-class)"
      },
      {
        "command": "vscodeUEHelper.enableClangdProxy",
        "title": "%cmd.enableClangdProxy.title%",
        "category": "UE Helper",
        "icon": "$(plug)"
      },
      {
        "command": "vscodeUEHelper.disableClangdProxy",
        "title": "%cmd.disableClangdProxy.title%",
        "category": "UE Helper",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "vscodeUEHelper.showClangdProxyStatus",
        "title": "%cmd.showClangdProxyStatus.title%",
        "category": "UE Helper",
        "icon": "$(info)"
      },
      {
        "command": "vscodeUEHelper.showControlPanel",
        "title": "%cmd.showControlPanel.title%",
        "category": "UE Helper",
        "icon": "$(dashboard)"
      },
      {
        "command": "vscodeUEHelper.retryFirstTimeInit",
        "title": "%cmd.retryFirstTimeInit.title%",
        "category": "UE Helper",
        "icon": "$(refresh)"
      },
      {
        "command": "vscodeUEHelper.refreshProjectExplorer",
        "title": "%cmd.refreshProjectExplorer.title%",
        "category": "UE Helper",
        "icon": "$(refresh)"
      },
      {
        "command": "vscodeUEHelper.openProjectExplorerFile",
        "title": "%cmd.openProjectExplorerFile.title%",
        "category": "UE Helper"
      },
      {
        "command": "vscodeUEHelper.copyBuildCommand",
        "title": "%cmd.copyBuildCommand.title%",
        "category": "UE Helper",
        "icon": "$(copy)"
      },
      {
        "command": "vscodeUEHelper.noLintCurrentLine",
        "title": "%cmd.noLintCurrentLine.title%",
        "category": "UE Helper"
      },
      {
        "command": "vscodeUEHelper.noLintNextLine",
        "title": "%cmd.noLintNextLine.title%",
        "category": "UE Helper"
      },
      {
        "command": "vscodeUEHelper.switchHeaderSource",
        "title": "%cmd.switchHeaderSource.title%",
        "category": "UE Helper"
      }
    ],
    "keybindings": [
      {
        "command": "vscodeUEHelper.switchHeaderSource",
        "key": "alt+o",
        "when": "editorTextFocus && editorLangId == 'cpp' || editorTextFocus && editorLangId == 'c'"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ueHelper",
          "title": "UE Helper",
          "icon": "$(tools)"
        }
      ]
    },
    "views": {
      "ueHelper": [
        {
          "type": "webview",
          "id": "vscodeUEHelper.controlPanel",
          "name": "%view.controlPanel.name%"
        },
        {
          "type": "tree",
          "id": "vscodeUEHelper.projectExplorer",
          "name": "%view.projectExplorer.name%",
          "when": "vscodeUEHelper.projectDetected"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscodeUEHelper.refreshProjectExplorer",
          "when": "view == vscodeUEHelper.projectExplorer",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "vscodeUEHelper.openTerminalInNewWindow",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "vscodeUEHelper.switchHeaderSource",
          "when": "editorTextFocus && editorLangId == 'cpp' || editorTextFocus && editorLangId == 'c'",
          "group": "9_uehelper@0"
        },
        {
          "command": "vscodeUEHelper.noLintCurrentLine",
          "when": "editorTextFocus",
          "group": "9_uehelper@1"
        },
        {
          "command": "vscodeUEHelper.noLintNextLine",
          "when": "editorTextFocus",
          "group": "9_uehelper@2"
        }
      ],
      "view/item/context": [
        {
          "command": "vscodeUEHelper.build",
          "when": "view == vscodeUEHelper.projectExplorer && viewItem == uprojectFile",
          "group": "ue5@1"
        },
        {
          "command": "vscodeUEHelper.launchEditor",
          "when": "view == vscodeUEHelper.projectExplorer && viewItem == uprojectFile",
          "group": "ue5@2"
        },
        {
          "command": "vscodeUEHelper.openTerminalInNewWindow",
          "when": "view == vscodeUEHelper.projectExplorer && viewItem == folder",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vscodeUEHelper.liveCoding",
          "when": "isWindows"
        },
        {
          "command": "vscodeUEHelper.setSystemIncludes",
          "when": "isWindows"
        },
        {
          "command": "vscodeUEHelper.enableClangdProxy"
        },
        {
          "command": "vscodeUEHelper.disableClangdProxy"
        },
        {
          "command": "vscodeUEHelper.showClangdProxyStatus"
        },
        {
          "command": "vscodeUEHelper.diagnoseProject"
        }
      ]
    },
    "configuration": {
      "title": "VSCode UE Helper",
      "properties": {
        "vscodeUEHelper.ueVersion": {
          "type": "string",
          "description": "%config.ueVersion.desc%"
        },
        "vscodeUEHelper.configuration": {
          "type": "string",
          "enum": [
            "Debug",
            "DebugGame",
            "Development",
            "Shipping",
            "Test"
          ],
          "enumDescriptions": [
            "Debug",
            "DebugGame",
            "Development",
            "Shipping",
            "Test"
          ],
          "default": "Development",
          "description": "%config.configuration.desc%"
        },
        "vscodeUEHelper.target": {
          "type": "string",
          "enum": [
            "Editor",
            "Game",
            "Server",
            "Client"
          ],
          "enumDescriptions": [
            "Editor",
            "Game",
            "Server",
            "Client"
          ],
          "default": "Editor",
          "description": "%config.target.desc%"
        },
        "vscodeUEHelper.platform": {
          "type": "string",
          "enum": [
            "Win64",
            "Mac",
            "Linux"
          ],
          "enumDescriptions": [
            "Win64",
            "Mac",
            "Linux"
          ],
          "default": "Win64",
          "description": "%config.platform.desc%"
        },
        "vscodeUEHelper.clangdPath": {
          "type": "string",
          "description": "%config.clangdPath.desc%"
        },
        "vscodeUEHelper.autoBackupWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoBackupWorkspace.desc%"
        },
        "vscodeUEHelper.editorAwareBuild": {
          "type": "boolean",
          "default": true,
          "description": "%config.editorAwareBuild.desc%"
        },
        "vscodeUEHelper.scaffold.clangFormat": {
          "type": "boolean",
          "default": true,
          "description": "%config.scaffold.clangFormat.desc%"
        },
        "vscodeUEHelper.scaffold.clangTidy": {
          "type": "boolean",
          "default": false,
          "description": "%config.scaffold.clangTidy.desc%"
        },
        "vscodeUEHelper.progressLocation": {
          "type": "string",
          "enum": [
            "window",
            "notification"
          ],
          "enumDescriptions": [
            "%config.progressLocation.enum.0%",
            "%config.progressLocation.enum.1%"
          ],
          "default": "window",
          "description": "%config.progressLocation.desc%"
        },
        "vscodeUEHelper.useMCP": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "description": "%config.useMCP.desc%"
        },
        "vscodeUEHelper.lspLoggingLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "%config.lspLoggingLevel.desc%"
        },
        "vscodeUEHelper.clangdProxy.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.clangdProxy.enabled.desc%"
        },
        "vscodeUEHelper.clangdProxy.keepaliveMax": {
          "type": "number",
          "default": 20,
          "description": "%config.clangdProxy.keepaliveMax.desc%"
        },
        "vscodeUEHelper.clangdProxy.keepaliveTtlSec": {
          "type": "number",
          "default": 900,
          "description": "%config.clangdProxy.keepaliveTtlSec.desc%"
        },
        "vscodeUEHelper.clangdProxy.realClangdPath": {
          "type": "string",
          "default": "",
          "description": "%config.clangdProxy.realClangdPath.desc%"
        },
        "vscodeUEHelper.clangdProxy.logPath": {
          "type": "string",
          "default": "",
          "description": "%config.clangdProxy.logPath.desc%"
        },
        "vscodeUEHelper.clangdProxy.localization.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.clangdProxy.localization.enabled.desc%"
        },
        "vscodeUEHelper.clangdProxy.localization.mode": {
          "type": "string",
          "enum": [
            "append",
            "zh-only"
          ],
          "default": "append",
          "description": "%config.clangdProxy.localization.mode.desc%"
        },
        "vscodeUEHelper.clangdProxy.dictionaryPath": {
          "type": "string",
          "default": "",
          "description": "%config.clangdProxy.dictionaryPath.desc%"
        },
        "vscodeUEHelper.showPerfInStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "%config.showPerfInStatusBar.desc%"
        },
        "vscodeUEHelper.clangd.userAddFlags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "compat-header",
              "macro-helper",
              "std-cxx20",
              "preparse-headers",
              "uht-include-dirs",
              "system-include-windows"
            ]
          },
          "default": [],
          "markdownDescription": "%config.clangd.userAddFlags.desc%"
        }
      }
    },
    "problemMatchers": [
      {
        "owner": "ue-helper-msvc",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s*(error|warning|note|fatal error)\\s+([A-Z]+\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ]
  },
  "extensionDependencies": [
    "llvm-vs-code-extensions.vscode-clangd"
  ],
  "scripts": {
    "build": "npm run clean && node esbuild.config.mjs",
    "clean": "node scripts/clean-out.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,mjs}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "npm run test:unit",
    "test:coverage": "vitest run --coverage",
    "prepackage": "npm run build",
    "package": "vsce package",
    "publish": "vsce publish",
    "perf:baseline": "node scripts/measure-proxy-overhead.mjs --baseline",
    "perf:after": "node scripts/measure-proxy-overhead.mjs --after",
    "perf:diff": "node scripts/measure-proxy-overhead.mjs --diff"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^3.6.0",
    "json5": "^2.2.3",
    "yaml": "^2.9.0"
  }
}
